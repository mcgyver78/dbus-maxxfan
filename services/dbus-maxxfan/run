#!/bin/sh
exec 2>&1

# Venus OS attaches a service to every new ttyUSB and probes it for VE.Direct
# and MK2, and that probing toggles DTR, which resets the Arduino. The port has
# to be released before the driver can use it - but only that one port. Doing
# it here, for every candidate, would stop the Venus driver of any other
# USB-serial device on the box and never put it back. The driver therefore
# releases a port itself, right before it asks what is on it, and hands it back
# to serial-starter immediately if the answer is not ours.

exec /usr/bin/python3 /data/dbus-maxxfan/dbus-maxxfan.py
